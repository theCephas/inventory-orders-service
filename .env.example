# Postgres container credentials (used by docker-compose)
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_DB=inventory_orders

# API
NODE_ENV=development
PORT=3000
# For running the API on your host. docker-compose overrides this to point at the postgres service.
DATABASE_URL=postgres://inventory:inventory@localhost:5432/inventory_orders
# Must be at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
JWT_EXPIRES_IN=1h

# Seed script (yarn seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin-password

# E2E tests (yarn test:e2e). The database name must end in _test; it is truncated between suites.
TEST_DATABASE_URL=postgres://inventory:inventory@localhost:5432/inventory_orders_test
